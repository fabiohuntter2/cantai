# Copie este arquivo para .env.local (no seu computador) ou cadastre
# cada linha em Vercel > Settings > Environment Variables.
# Qualquer chave vazia deixa aquela parte em MODO DEMONSTRAÇÃO.

# Nome e preço
NOME_DO_APP=Cantaí
PRECO_MUSICA=19.90
EMAIL_SUPORTE=contato@seudominio.com.br

# Senha da página /admin (lista de pedidos)
ADMIN_SENHA=

# Letra (Anthropic / Claude) - console.anthropic.com
ANTHROPIC_API_KEY=
MODELO_LETRA=claude-haiku-5-5

# Música (ElevenLabs) - elevenlabs.io > Developers > API Keys
ELEVENLABS_API_KEY=
MODELO_MUSICA=music_v1

# Pagamento Pix (Mercado Pago) - mercadopago.com.br/developers > Suas integrações
MERCADOPAGO_ACCESS_TOKEN=

# Banco de dados (Upstash Redis) e arquivos (Vercel Blob)
# Na Vercel, estas variáveis aparecem sozinhas quando você conecta
# os serviços em Storage. Não precisa digitar.
KV_REST_API_URL=
KV_REST_API_TOKEN=
BLOB_READ_WRITE_TOKEN=
